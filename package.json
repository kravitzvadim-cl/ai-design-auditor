{
  "name": "ai-design-system-auditor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local deterministic design-system auditing with controlled Chromium capture",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "audit:fixture": "node dist/src/cli.js",
    "demo": "npm run build && node dist/tools/run-fixture-demo.js",
    "capture": "npm run build && node dist/src/capture-cli.js",
    "report": "npm run build && node dist/src/report-cli.js",
    "intake": "npm run build && node dist/tools/start-intake.js",
    "check:supabase": "npm run build && node dist/tools/check-supabase.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  }
}
